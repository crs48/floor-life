---
import { href } from '../lib/url';
interface Props { title?: string; blurb?: string }
const { title = 'Stay a little closer to the ground.', blurb = 'New field notes, practical guides, and the occasional well-supported opinion. Follow along at your own pace.' } = Astro.props;
---
<section class="mx-auto max-w-6xl px-5 sm:px-8">
  <div class="rounded-soft border border-line bg-claypaper/60 px-6 py-10 sm:px-12 sm:py-12">
    <div class="grid items-center gap-8 md:grid-cols-[1.3fr_1fr]">
      <div><p class="eyebrow mb-3">Notes from down here</p><h2 class="display-3">{title}</h2><p class="mt-3 max-w-md">{blurb}</p></div>
      <div class="flex flex-wrap items-center gap-6 md:justify-end"><a href={href('/rss.xml')} class="rounded-pill bg-ink px-6 py-3 font-semibold text-paper no-underline">Follow via RSS ↗</a><a href={href('/journal')} class="field-link">Read the journal →</a></div>
    </div>
    <p class="mt-5 text-xs text-inkmuted">Add the RSS link to your feed reader. No email address or account needed.</p>
  </div>
</section>
