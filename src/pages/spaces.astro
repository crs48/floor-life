---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Callout from '../components/Callout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import Figure from '../components/Figure.astro';
import floorScene from '../assets/floor-scene.png';
import { href } from '../lib/url';

const rooms = [
  {
    icon: 'home',
    room: 'The living room',
    lead: 'Lower the centre of gravity.',
    body: 'You don\'t have to lose the sofa. Add a firm rug over a dense pad, a couple of floor cushions and a bolster, and a low table within arm\'s reach. A lower sofa (or none) makes the whole room feel taller and pulls life down toward the floor.',
    tips: ['Layer: firm base, then a movable cushion only where you actually sit', 'Keep a stable chair nearby for support and a different seating option'],
  },
  {
    icon: 'book',
    room: 'The workspace',
    lead: 'Make room for a change of position.',
    body: 'Try a short task at a low table before redesigning a whole workday. A laptop alone can make it difficult to place both screen and keyboard comfortably; an external keyboard may help. Compare the actual adjustment range if you want a desk or monitor arm to serve several heights.',
    tips: ['Measure leg clearance and keep elbows and shoulders comfortable', 'Keep a higher seat available and move between tasks when you can'],
  },
  {
    icon: 'tea',
    room: 'The dining nook',
    lead: 'Dinner, at a different altitude.',
    body: 'A chabudai — a low Japanese table — turns meals into floor time, with cushions or a seiza bench around it. In cold months a kotatsu (a low table with a heater and a quilt) is the single cosiest object in floor living. Use only heating equipment certified for your local electrical supply and follow its installation and fire-safety instructions.',
    tips: ['A round low table seats more people flexibly than a long one', 'Offer both low seats and regular chairs so guests can choose'],
  },
  {
    icon: 'ground',
    room: 'The bedroom',
    lead: 'Roll the bed away.',
    body: 'A shikibuton — a thin roll-up futon, ideally on a tatami platform — lets the bedroom become a living room by day. It is the original small-space trick: one room, many lives. Choose bedding for your own pressure comfort and plan how to get up easily. Follow its care instructions and check underneath for moisture.',
    tips: ['Follow the bedding maker’s airing schedule and check for moisture', 'Check the recommended base; a mat alone does not guarantee ventilation'],
  },
];
---

<BaseLayout
  title="Set up your space"
  description="Make one corner floor-friendly, then explore practical room ideas, comfortable supports, stable surfaces, and options for guests."
>
  <PageHeader
    eyebrow="Interior design, minus the upheaval"
    title="One very inviting corner."
    lede="Your sofa has not been fired. Give the floor a small promotion: a comfortable spot, a little light, and an easy way back up. Start with the room you already have."
  />

  <section class="mx-auto mt-12 max-w-5xl px-5 sm:px-8">
    <Figure
      src={floorScene}
      alt="A sunlit room set up for floor living: a low cushion, a chabudai with a cup, a plant, and a bright window."
      caption="One corner, done well — a cushion, a low table, a plant, and good light."
      credit="Illustration: Floor Life"
      priority
    />
  </section>

  <!-- One corner -->
  <section class="mx-auto mt-16 max-w-4xl px-5 sm:px-8">
    <div class="rounded-soft border border-clay/30 bg-claypaper/50 px-6 py-10 sm:px-10">
      <p class="eyebrow text-claydeep">Start here</p>
      <h2 class="mt-2 display-3 font-display text-ink">Make one corner irresistible</h2>
      <p class="mt-4 text-lg leading-relaxed text-inksoft">
        Don't redesign your home. Choose a single corner — by a window, near the
        books — and make it the nicest place to be low: a soft rug, one good
        cushion, a low table, a plant, warm light. Try a few short visits and see whether the spot suits you. Keep a stable
        support for getting up within reach, and adjust the setup before buying more.
      </p>
    </div>
  </section>

  <!-- Rooms -->
  <section class="mx-auto mt-24 max-w-6xl px-5 sm:px-8">
    <SectionHeader eyebrow="Room by room" title="Same home. A few new possibilities." />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        rooms.map((r) => (
          <article class="flex flex-col rounded-soft border border-line bg-paper/60 p-7">
            <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-soft bg-sage/12 text-sagedeep">
              <Icon name={r.icon as any} size={22} />
            </span>
            <h3 class="font-display text-2xl text-ink">{r.room}</h3>
            <p class="mt-1 font-display text-lg italic text-clay">{r.lead}</p>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-inksoft">{r.body}</p>
            <ul class="mt-4 space-y-2 border-t border-linesoft pt-4">
              {r.tips.map((t) => (
                <li class="flex gap-2 text-sm text-inksoft">
                  <span class="mt-0.5 text-sagedeep" aria-hidden="true">→</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Firm and warm -->
  <section class="mx-auto mt-24 max-w-4xl px-5 sm:px-8">
    <SectionHeader
      eyebrow="The one rule underfoot"
      title="Firm and warm beats soft and cold"
    />
    <div class="mt-8 space-y-5 text-lg leading-relaxed text-inksoft">
      <p>
        A cushion should be comfortable; a surface you push against should be
        stable. Very soft padding can make a transfer feel less predictable.
        Try the whole route down and back up with support before settling in.
        Comfort is personal, and neither a hard floor nor an upright spine is a
        health requirement.
      </p>
      <p>
        Build in layers if you like: a secure rug or mat, then movable padding
        where your body rests. Keep edges flat, walking paths clear, and a
        stable chair nearby. Choose washable materials and check for moisture
        beneath bedding. Warmth matters too, but ordinary heating and a blanket
        may do the job without adding electrical equipment under a rug.
      </p>
    </div>
    <div class="mt-8">
      <Callout variant="note" title="The start-with-what-you-own kit">A stable surface, a firm cushion or folded blanket, a secure way back up, and something pleasant to do. Add other equipment only when you can name the problem it will solve. <a href={href('/gear')}>Explore the optional extras →</a></Callout>
    </div>
  </section>
</BaseLayout>
